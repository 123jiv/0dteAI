# RevenueCat public iOS SDK key (Project settings → API keys → App specific keys), for local builds.
# EAS cloud builds never see this file: set the key as an EAS environment variable (README, Before launch 1).
# Empty: dev builds run the paywall in preview mode (no real charges); release builds sell nothing.
# Release builds only accept an App Store key (appl_...).
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
