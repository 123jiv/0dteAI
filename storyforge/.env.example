# ── AI provider ──────────────────────────────────────────────
# "anthropic" | "openai" | "demo"  (demo needs no key — generates sample prose)
AI_PROVIDER=demo

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# ── Supabase (optional — app falls back to local-only storage) ─
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only key — required for the paywall. NEVER expose publicly.
SUPABASE_SERVICE_ROLE_KEY=

# ── Stripe paywall (optional — dormant until all keys are set) ──
# Requires Supabase above as well. See README "Paywall" section.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
# Display + limits (optional)
PRO_PRICE_LABEL=$9.99/month
FREE_CHAPTERS_PER_MONTH=5
