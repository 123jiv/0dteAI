# ── AI provider ──────────────────────────────────────────────
# "anthropic" | "openai" | "demo"  (demo needs no key — generates sample prose)
AI_PROVIDER=demo

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# ── Supabase (optional — app falls back to local-only storage) ─
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
